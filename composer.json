{
    "name": "respinar/contao-calltoaction",
    "description": "A Call to action bundle for Contao CMS",
    "keywords": ["contao", "CTA", "bundle"],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Hamid Peywasti",
            "email": "hamid@respinar.com",
            "homepage": "https://respinar.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/respinar/contao-calltoaction/issues",
        "source": "https://github.com/respinar/contao-calltoaction"
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle":"^5.3"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/easy-coding-standard": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "Respinar\\CallToActionBundle\\": "src/"
        }
    },    
    "extra": {
        "contao-manager-plugin": "Respinar\\CallToActionBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "contao/manager-plugin": true
        }
    }
}
